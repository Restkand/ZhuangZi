---
import Dasar from './Dasar.astro';
import { NAMA, PENULIS } from '../lib/situs';

interface Props {
  judul: string;
  bab: string;
  ilustrasi: string;
  ilustrasiAlt: string;
  menitBaca: number;
  deskripsi: string;
  gambar: string;
  berikutnya?: { judul: string; href: string };
}

const { judul, bab, ilustrasi, ilustrasiAlt, menitBaca, deskripsi, gambar, berikutnya } =
  Astro.props;

// Memberi tahu mesin pencari bahwa ini artikel berbahasa Indonesia yang diceritakan ulang dari kitab Zhuangzi.
const dataKisah = {
  '@type': 'Article',
  headline: judul,
  description: deskripsi,
  image: new URL(gambar, Astro.site).href,
  inLanguage: 'id',
  author: { '@type': 'Person', name: PENULIS },
  isPartOf: { '@type': 'WebSite', name: NAMA, url: new URL('/', Astro.site).href },
  isBasedOn: {
    '@type': 'Book',
    name: `Zhuangzi, ${bab}`,
    author: { '@type': 'Person', name: 'Zhuangzi' },
  },
};
---

<Dasar
  judul={judul}
  labelJudul="Kisah Zhuangzi"
  deskripsi={deskripsi}
  gambar={gambar}
  gambarAlt={ilustrasiAlt}
  jenis="article"
  dataTerstruktur={dataKisah}
>
  <article class="kisah">
    <img class="ilustrasi" src={ilustrasi} alt={ilustrasiAlt} width="550" height="350" />
    <h1>{judul}</h1>
    <p class="sumber">
      <em>Dari kitab Zhuangzi, {bab}</em>
      <span class="waktu-baca">sekitar {menitBaca} menit membaca</span>
    </p>

    <div class="isi">
      <slot />
    </div>

    <p class="catatan">
      Diceritakan ulang dari teks asli Zhuangzi dan terjemahan James Legge (1891), keduanya domain
      publik, dengan bantuan AI. Bukan terjemahan akademis.
    </p>
  </article>

  <nav class="berikutnya">
    {
      berikutnya ? (
        <a href={berikutnya.href}>
          <span class="label">Kisah berikutnya</span>
          <span class="judul-berikutnya">{berikutnya.judul}</span>
        </a>
      ) : (
        <p>
          Untuk sementara, ini kisah terakhir. Kisah berikutnya sedang ditulis, pelan-pelan.
          <br />
          <a href="/">Kembali ke daftar kisah</a>
        </p>
      )
    }
  </nav>
</Dasar>
