---
import '@fontsource/lora/latin-400.css';
import '@fontsource/lora/latin-400-italic.css';
import '@fontsource/lora/latin-500.css';
import lora400 from '@fontsource/lora/files/lora-latin-400-normal.woff2?url';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import MusikLatar from '../components/MusikLatar.astro';
import Stempel from '../components/Stempel.astro';
import { DESKRIPSI, NAMA, jsonLd } from '../lib/situs';

interface Props {
  judul?: string;
  // Kata kunci tambahan di judul tab, mis. "Kisah Zhuangzi" pada halaman kisah.
  labelJudul?: string;
  deskripsi?: string;
  gambar?: string;
  gambarAlt?: string;
  jenis?: 'website' | 'article';
  dataTerstruktur?: Record<string, unknown>;
}

const {
  judul,
  labelJudul,
  deskripsi = DESKRIPSI,
  gambar = '/og/beranda.png',
  gambarAlt = 'Gambar tinta seekor kupu-kupu yang sedang terbang, dengan stempel merah kecil.',
  jenis = 'website',
  dataTerstruktur,
} = Astro.props;

// Beranda: merek dulu, lalu kata kunci. Halaman lain: judulnya dulu, merek di akhir.
const judulHalaman = judul
  ? [judul, labelJudul, NAMA].filter(Boolean).join(' · ')
  : `${NAMA} · Kisah-kisah Zhuangzi dalam Bahasa Indonesia`;
const alamat = new URL(Astro.url.pathname, Astro.site);
const alamatGambar = new URL(gambar, Astro.site);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{judulHalaman}</title>
    <meta name="description" content={deskripsi} />
    <link rel="canonical" href={alamat} />

    <meta property="og:type" content={jenis} />
    <meta property="og:site_name" content={NAMA} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={judul ?? NAMA} />
    <meta property="og:description" content={deskripsi} />
    <meta property="og:url" content={alamat} />
    <meta property="og:image" content={alamatGambar} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={gambarAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f1e7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f1c18" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={NAMA} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={lora400} as="font" type="font/woff2" crossorigin />
    <!-- Data untuk mesin pencari, bukan skrip yang dijalankan; tidak terkena CSP script-src. -->
    {
      dataTerstruktur && (
        <script is:inline type="application/ld+json" set:html={jsonLd(dataTerstruktur)} />
      )
    }

    <!-- Skrip disimpan sebagai file terpisah agar Content-Security-Policy bisa ketat (lihat vercel.json). -->
    <script is:inline src="/js/tema-awal.js"></script>
    <!-- Navigasi mulus antarhalaman, agar musik latar tidak terputus. Tanpa JS, tautan biasa tetap bekerja. -->
    <ClientRouter />
  </head>
  <body>
    <!-- Header (beserta musik dan tombol tema) dipertahankan saat pindah halaman. -->
    <header class="kepala" transition:persist="kepala">
      <a href="/" class="nama-situs">{NAMA}</a>
      <nav>
        <a href="/tentang/">Tentang</a>
        <MusikLatar />
        <button class="tombol-tema" type="button" hidden>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
            <path d="M10 3.5 a6.5 6.5 0 0 1 0 13 Z" fill="currentColor"></path>
          </svg>
        </button>
        <script is:inline src="/js/tema.js" defer></script>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="kaki">
      <Stempel />
      <p>
        Gratis dan tanpa iklan. Teks asli Zhuangzi dan terjemahan Legge adalah domain publik;
        penceritaan ulang di sini berlisensi
        <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.id">CC BY-NC-SA 4.0</a>.
      </p>
      <p><a href="/rss.xml">Ikuti lewat RSS</a></p>
    </footer>
  </body>
</html>
