---
import '@fontsource/lora/latin-400.css';
import '@fontsource/lora/latin-400-italic.css';
import '@fontsource/lora/latin-500.css';
import lora400 from '@fontsource/lora/files/lora-latin-400-normal.woff2?url';
import '../styles/global.css';
import Stempel from '../components/Stempel.astro';

interface Props {
  judul?: string;
  deskripsi?: string;
  gambar?: string;
  gambarAlt?: string;
  jenis?: 'website' | 'article';
}

const {
  judul,
  deskripsi = 'Kisah-kisah dari kitab Zhuangzi, diceritakan ulang dalam bahasa Indonesia yang tenang.',
  gambar = '/og/beranda.png',
  gambarAlt = 'Gambar tinta seekor kupu-kupu yang sedang terbang, dengan stempel merah kecil.',
  jenis = 'website',
} = Astro.props;
const judulHalaman = judul ? `${judul} · Kisah Zhuangzi` : 'Kisah Zhuangzi';
const alamat = new URL(Astro.url.pathname, Astro.site);
const alamatGambar = new URL(gambar, Astro.site);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{judulHalaman}</title>
    <meta name="description" content={deskripsi} />
    <link rel="canonical" href={alamat} />

    <meta property="og:type" content={jenis} />
    <meta property="og:site_name" content="Kisah Zhuangzi" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={judul ?? 'Kisah Zhuangzi'} />
    <meta property="og:description" content={deskripsi} />
    <meta property="og:url" content={alamat} />
    <meta property="og:image" content={alamatGambar} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={gambarAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f1e7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f1c18" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Kisah Zhuangzi" href="/rss.xml" />
    <link rel="preload" href={lora400} as="font" type="font/woff2" crossorigin />

    <!-- Skrip disimpan sebagai file terpisah agar Content-Security-Policy bisa ketat (lihat vercel.json). -->
    <script is:inline src="/js/tema-awal.js"></script>
  </head>
  <body>
    <header class="kepala">
      <a href="/" class="nama-situs">Kisah Zhuangzi</a>
      <nav>
        <a href="/tentang/">Tentang</a>
        <button class="tombol-tema" type="button" hidden>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
            <path d="M10 3.5 a6.5 6.5 0 0 1 0 13 Z" fill="currentColor"></path>
          </svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="kaki">
      <Stempel />
      <p>
        Gratis dan tanpa iklan. Teks asli Zhuangzi dan terjemahan Legge adalah domain publik;
        penceritaan ulang di sini berlisensi
        <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.id">CC BY-NC-SA 4.0</a>.
      </p>
      <p><a href="/rss.xml">Ikuti lewat RSS</a></p>
    </footer>

    <script is:inline src="/js/tema.js" defer></script>
  </body>
</html>
