---
import '../styles/global.css';

interface Props {
  judul?: string;
}

const { judul } = Astro.props;
const judulHalaman = judul ? `${judul} · Kisah Zhuangzi` : 'Kisah Zhuangzi';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Kisah-kisah dari kitab Zhuangzi, diceritakan ulang dalam bahasa Indonesia yang tenang." />
    <meta name="color-scheme" content="light dark" />
    <title>{judulHalaman}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&display=swap"
    />
  </head>
  <body>
    <header class="kepala">
      <a href="/" class="nama-situs">Kisah Zhuangzi</a>
      <a href="/tentang/">Tentang</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
