---
import { isiKupu, viewBoxKupu } from '../lib/kupu';

interface Props {
  class?: string;
}

const { class: kelas } = Astro.props;
const isi = isiKupu({ pekat: 'var(--tinta-pekat)', abu: 'var(--abu-2)', abuMuda: 'var(--abu-3)' });
---

<svg class:list={['kupu', kelas]} viewBox={viewBoxKupu} aria-hidden="true" set:html={isi} />

<style>
  .kupu {
    display: block;
  }
</style>
