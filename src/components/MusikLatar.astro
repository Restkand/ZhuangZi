---
// Musik latar yang hanya berbunyi bila pembaca memintanya. Tidak pernah autoplay;
// file baru diunduh saat tombol ditekan. Tanpa JavaScript, tombol tetap tersembunyi.
// Sumber dan lisensi: lihat halaman Tentang.
---

<p class="musik">
  <button class="tombol-musik" type="button" aria-pressed="false" hidden>
    <span aria-hidden="true">♪</span>
    <span class="teks-musik">Putar musik latar</span>
  </button>
  <audio class="audio-musik" preload="none" loop>
    <source src="/musik/pei-lan.ogg" type="audio/ogg" />
    <source src="/musik/pei-lan.mp3" type="audio/mpeg" />
  </audio>
</p>

<script is:inline>
  (() => {
    const tombol = document.querySelector('.tombol-musik');
    const audio = document.querySelector('.audio-musik');
    if (!tombol || !audio) return;

    const teks = tombol.querySelector('.teks-musik');
    const perbarui = () => {
      tombol.setAttribute('aria-pressed', String(!audio.paused));
      teks.textContent = audio.paused ? 'Putar musik latar' : 'Hentikan musik latar';
    };

    audio.volume = 0.5;
    tombol.hidden = false;
    tombol.addEventListener('click', () => (audio.paused ? audio.play() : audio.pause()));
    audio.addEventListener('play', perbarui);
    audio.addEventListener('pause', perbarui);
  })();
</script>
