---
// Musik latar yang hanya berbunyi bila pembaca memintanya. Tidak pernah autoplay;
// file baru diunduh saat tombol ditekan. Tanpa JavaScript, tombol tetap tersembunyi.
// Letaknya di header yang dipertahankan antarhalaman (lihat Dasar.astro), jadi musik
// tidak terputus saat pembaca berpindah kisah. Sumber dan lisensi: lihat halaman Tentang.
---

<button
  class="tombol-musik"
  type="button"
  aria-pressed="false"
  aria-label="Putar musik latar"
  title="Putar musik latar"
  hidden
>
  <svg viewBox="0 0 20 20" aria-hidden="true">
    <path
      d="M8 14.5 V4.5 L15 3 V12.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <ellipse cx="6.2" cy="14.6" rx="2.1" ry="1.6" fill="currentColor"></ellipse>
    <ellipse cx="13.2" cy="12.6" rx="2.1" ry="1.6" fill="currentColor"></ellipse>
  </svg>
</button>
<audio class="audio-musik" preload="none" loop>
  <source src="/musik/pei-lan.ogg" type="audio/ogg" />
  <source src="/musik/pei-lan.mp3" type="audio/mpeg" />
</audio>
<script is:inline src="/js/musik.js" defer></script>
