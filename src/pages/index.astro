---
import Dasar from '../layouts/Dasar.astro';
import Kupu from '../components/Kupu.astro';
import Potret from '../components/Potret.astro';
import { daftarKisah, nomorBab } from '../lib/kisah';
import { DESKRIPSI, NAMA, SLOGAN } from '../lib/situs';

const daftar = await daftarKisah();

const dataSitus = {
  '@type': 'WebSite',
  name: NAMA,
  alternateName: 'Kisah Zhuangzi',
  description: DESKRIPSI,
  url: new URL('/', Astro.site).href,
  inLanguage: 'id',
};

// Kelompokkan menurut pembagian kitab: Bab Dalam, Bab Luar, Bab Campuran.
const kelompok = [
  {
    nama: 'Bab Dalam',
    keterangan: 'Tujuh bab pertama, yang dianggap paling dekat dengan Zhuangzi sendiri.',
    dari: 1,
    sampai: 7,
  },
  {
    nama: 'Bab Luar',
    keterangan: 'Lima belas bab berikutnya, banyak ditulis oleh murid dan penerusnya.',
    dari: 8,
    sampai: 22,
  },
  {
    nama: 'Bab Campuran',
    keterangan: 'Sebelas bab terakhir, kumpulan tulisan dari berbagai tangan.',
    dari: 23,
    sampai: 33,
  },
].map((k) => ({
  ...k,
  kisah: daftar.filter((kisah) => {
    const nomor = nomorBab(kisah.data.bab);
    return nomor >= k.dari && nomor <= k.sampai;
  }),
}));
---

<Dasar dataTerstruktur={dataSitus}>
  <section class="beranda">
    <Kupu class="kupu-beranda" />
    <h1>{NAMA}</h1>
    <p class="slogan">{SLOGAN}</p>
    <p class="pengantar">
      Kisah-kisah dari kitab Zhuangzi, diceritakan ulang dalam bahasa Indonesia. Untuk dibaca
      pelan-pelan, satu kisah setiap kali.
    </p>

    <section class="siapa" aria-labelledby="judul-siapa">
      <h2 id="judul-siapa">Siapa Zhuangzi</h2>
      <div class="siapa-isi">
        <a href="/tentang/#zhuangzi" class="tautan-potret" tabindex="-1" aria-hidden="true">
          <Potret versi="potong" />
        </a>
        <div>
          <p class="pengantar">
            Zhuangzi adalah seorang pemikir Tiongkok yang hidup sekitar abad ke-4 sebelum Masehi. Ia
            jarang menasihati. Ia lebih suka bercerita: tentang juru masak, kupu-kupu, dan ikan yang
            berenang di sungai.
          </p>
          <p><a href="/tentang/#zhuangzi">Lebih lanjut tentang Zhuangzi →</a></p>
        </div>
      </div>
    </section>

    <p class="pengantar">
      Nama tempat ini diambil dari salah satu ceritanya. Seorang sahabat mengeluh tentang pohon besar
      yang batangnya berbonggol dan dahannya bengkok, sampai tak ada tukang kayu yang mau
      meliriknya. Zhuangzi menjawab: tanam saja ia di padang
      yang lapang, lalu berbaringlah dengan tenang di bawahnya. Karena tak berguna, tak ada kapak yang
      akan menebangnya.
    </p>

    {
      daftar.length === 0 && <p class="kosong">Kisah pertama sedang ditulis.</p>
    }

    {
      kelompok
        .filter((k) => k.kisah.length > 0)
        .map((k) => (
          <section class="kelompok">
            <h2>{k.nama}</h2>
            <p class="keterangan-kelompok">{k.keterangan}</p>
            <ol class="daftar-kisah">
              {k.kisah.map((kisah) => (
                <li>
                  <a href={`/kisah/${kisah.id}/`}>
                    <span class="bab">{kisah.data.bab}</span>
                    <span class="judul-kisah">{kisah.data.judul}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
    }
  </section>

  <!-- Pembuka kupu-kupu setiap kali beranda dibuka; lihat komentar di dalam berkasnya. -->
  <script is:inline src="/js/kupu-datang.js" defer></script>
</Dasar>
